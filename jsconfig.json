{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": [
    "src/intelligence/**/*"
  ],
  "exclude": [
    "node_modules",
    "docs"
  ]
}
